IMAGE_TAG=latest
IMAGE=ghcr.io/joeblack2k/retrosavemanager

AUTH_MODE=disabled
VITE_AUTH_REQUIRED=false
# Required together when AUTH_MODE=enabled unless TRUST_REMOTE_USER_HEADER=true
RSM_ADMIN_EMAIL=admin@example.invalid
RSM_ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Set true when the public browser connection is HTTPS. Auto-detected from BASE_URL/TLS when empty.
AUTH_COOKIE_SECURE=
# Only enable behind an authenticating reverse proxy that strips client-supplied Remote-User headers.
TRUST_REMOTE_USER_HEADER=false
# Only enable when requests reach RSM through a trusted reverse proxy that rewrites client IP headers.
# When disabled, X-Forwarded-For/X-Real-IP cannot influence login throttling via chi RealIP.
TRUST_PROXY_HEADERS=false
HTTP_PORT=80
PORT=80

# Maximum complete multipart request size in bytes (default: 128 MiB)
MAX_MULTIPART_BODY_BYTES=134217728

# Optional if you use a fixed internal hostname
PUBLIC_HOST=retrosavemanager.lan
BASE_URL=
TLS_ENABLED=false
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
BOOTSTRAP_DEMO_DATA=false

# Persistent data folders (required, use absolute host paths)
CONFIG_HOST_PATH=/srv/retrosavemanager/config
SAVES_HOST_PATH=/srv/retrosavemanager/saves

# Optional macvlan profile settings
MACVLAN_PARENT=eth0
MACVLAN_SUBNET=198.51.100.0/24
MACVLAN_GATEWAY=198.51.100.1
MACVLAN_IP=198.51.100.250
